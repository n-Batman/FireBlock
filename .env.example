# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
FIRMS_MAP_KEY=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_APPLICATION_KEY_ID=
B2_BUCKET_NAME=

# Free ArcGIS API key (https://developers.arcgis.com) for the satellite tiles and address search.
# Optional: without it the map and the search fall back to Esri's keyless services.
# NEXT_PUBLIC_ means the browser sees it. Use a key limited to those two services.
NEXT_PUBLIC_ARCGIS_KEY=

# NWS server-side application identification. No API key is needed.
# Optionally replace the project URL with your support website/email. Never use NEXT_PUBLIC_.
NWS_USER_AGENT=FireBlock/0.1 (https://github.com/n-Batman/FireBlock)

# Backend-only bearer token for private parcel scan archive reads/writes.
# Set a strong random value on trusted callers and the server; never NEXT_PUBLIC_.
CLOUD_WRITE_TOKEN=
